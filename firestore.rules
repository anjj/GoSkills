rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'julian.joven.andres@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                    && (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastSeen', 'email'])); 

      function isValidUser(data) {
        return data.email is string && data.email.size() <= 256
               && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
               && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
               && (!('lastSeen' in data) || (data.lastSeen is string));
      }

      match /progress/{courseId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidProgress(incoming());

        function isValidProgress(data) {
          return data.courseId is string && data.courseId.size() <= 128
                 && data.completed is bool
                 && (!('completedAt' in data) || (data.completedAt is string));
        }
      }
    }

    // 2. Courses Collection
    match /courses/{courseId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(courseId);
      allow create: if isSignedIn() && isValidId(courseId) && isValidCourse(incoming()) && ('createdAt' in incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(courseId) && isValidCourse(incoming()) && (incoming().get('createdAt', null) == existing().get('createdAt', null) || !('createdAt' in existing()));
      allow delete: if isAdmin() && isValidId(courseId);

      function isValidCourse(data) {
        return data.keys().hasAll(['title', 'category', 'chapters'])
               && data.title is string && data.title.size() <= 256
               && data.category is string && data.category.size() <= 128
               && data.chapters is list && data.chapters.size() <= 100
               && (!('published' in data) || data.published is bool)
               && (!('description' in data) || (data.description is string && data.description.size() <= 10000))
               && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048))
               && (!('duration' in data) || (data.duration is string && data.duration.size() <= 64))
               && (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt == null))
               && (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt == null));
      }
    }

    // 3. Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
